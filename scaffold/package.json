{
  "name": "treatable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "model:fetch": "node scripts/fetch-model.mjs",
    "dev": "node scripts/run-next.mjs dev",
    "dev:lan": "node scripts/run-next.mjs dev --lan",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --import tsx --test \"lib/contracts/__tests__/*.test.ts\"",
    "data:fetch": "node --import tsx scripts/1-fetch-ctgov.mjs",
    "data:normalize": "node --import tsx scripts/2-normalize.mjs",
    "data:embed": "node --import tsx scripts/3-embed.mjs",
    "data:embed:local": "node scripts/3-embed.mjs --target=local",
    "data:embed:builtin": "node --import tsx scripts/3-embed.mjs --space=builtin",
    "data:precompute": "node --import tsx scripts/4-precompute.mjs",
    "data:all": "npm run data:fetch && npm run data:normalize && npm run data:embed:builtin && npm run data:precompute",
    "data:refresh": "node --import tsx scripts/refresh-corpus.mjs",
    "check:hex": "node scripts/design/check-hex.mjs",
    "check:contrast": "node scripts/design/contrast-check.mjs",
    "test": "tsx --import ./scripts/_scrubProviderEnvForTests.mjs --test \"lib/**/__tests__/**/*.test.ts\" \"app/**/__tests__/**/*.test.ts\" \"scripts/**/__tests__/**/*.test.ts\" \"components/**/__tests__/**/*.test.ts\"",
    "e2e": "playwright test",
    "check:prompts": "node scripts/check-prompt-registry.mjs",
    "cost:measure": "node --import tsx scripts/cost-measure.mjs",
    "eval:precomputed": "node --import tsx scripts/eval-precomputed.mjs",
    "eval:quality": "node --import tsx scripts/eval-run.mjs",
    "eval:builtin": "node --import tsx scripts/eval-builtin-space.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@huggingface/transformers": "4.3.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sweetalert2": "^11.26.25",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-web": "1.30.0"
    },
    "source-map-js": "1.2.2"
  }
}

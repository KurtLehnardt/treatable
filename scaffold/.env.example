# Treatable: all patient embeddings stay local. Every key is optional.
# Copy to .env.local or run npm run setup. Never commit real API keys.
OPENAI_API_KEY=
OPENAI_STUDY_MODEL=gpt-4.1-mini
# OpenAI is used only after selecting it and explicitly consenting in the UI.
# Local chat is supplied by Ollama at 127.0.0.1:11434; install with setup:local.
LOCAL_LLM_MODEL=gemma4:latest
SEARCH_EMBEDDINGS=builtin
CORPUS_MAX=2000
# START_HOST=0.0.0.0 enables a trusted LAN host; default is 127.0.0.1.
# START_HOST=127.0.0.1
# Model mirror, same pinned/checksummed files:
# TREATABLE_MODEL_URL=https://mirror.example.org/nomic-embed-text-v1.5

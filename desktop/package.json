{
  "name": "treatable-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Treatable Desktop: a local-first study finder. Research information, not medical advice.",
  "author": "Kurt Lehnardt",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run copy-data && node scripts/run-electron-vite.mjs dev",
    "build": "npm run copy-data && electron-vite build",
    "copy-data": "node scripts/copy-data.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test \"src/**/__tests__/**/*.test.ts\" \"src/**/__tests__/**/*.test.tsx\" \"tests/*.test.ts\"",
    "guard": "node scripts/guard-readonly.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "io.github.kurtlehnardt.treatable.desktop",
    "productName": "Treatable Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/data/studies.json", "to": "data/studies.json" },
      { "from": "resources/data/us-zip-centroids.json", "to": "data/us-zip-centroids.json" },
      { "from": "resources/data/provenance.json", "to": "data/provenance.json" }
    ]
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "^7.0.0"
  }
}

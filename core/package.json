{
  "name": "@treatable/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime-neutral shared core for the Treatable apps.",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./node/ports.node.ts"
  },
  "scripts": {
    "test": "tsx --test \"tests/**/*.test.ts\" \"strings/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.src.json",
    "drift-check": "node scripts/drift-check.mjs",
    "smoke:ctgov-live": "tsx scripts/ctgov-live-smoke.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}

{
  "name": "treatable-extension",
  "version": "1.0.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test native/test/*.test.mjs",
    "pretest": "npm run build:all",
    "build:b": "node scripts/build.mjs --variant=b",
    "build:all": "npm run build:a && npm run build:b && npm run build",
    "build:a": "node scripts/build.mjs --variant=a",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:set": "node scripts/bump-version.mjs set"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sweetalert2": "11.26.25",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^22",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "react-test-renderer": "^18.3.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}

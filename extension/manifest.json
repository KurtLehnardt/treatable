{
  "manifest_version": 3,
  "name": "Treatable \u2014 local-first study finder",
  "version": "0.1.0",
  "description": "ClinicalTrials.gov study finder for patients. Local-first; optional OpenAI scoring only after the user opts in.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "scripting",
    "sidePanel",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Treatable"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://api.openai.com; base-uri 'none'; frame-src 'none'"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
